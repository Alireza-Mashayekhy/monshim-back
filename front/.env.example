# ===== Monshim Front (Next.js) — متغیرهای محیطی =====
# این فایل را به `.env.local` کپی کنید و مقادیر را کامل کنید.
# روی سرور محصول هم همین متغیرها باید در env فرانت (PM2/پروسهٔ next start)
# ست شوند؛ مقادیر نمونهٔ سرور در کامنت هر متغیر آمده است.

# --- API مرورگر ---
# پیشنهاد: /api روی همان دامنهٔ سایت؛ nginx یا API_PROXY_TARGET آن را به
# بک‌اند می‌رساند. کوکی‌های HttpOnly در این حالت برای Next و مرورگر یکسان‌اند.
# NEXT_PUBLIC_* هنگام build داخل باندل مرورگر قرار می‌گیرد؛ تغییر آن build
# مجدد می‌خواهد. پسوند /api الزامی است.
NEXT_PUBLIC_API_URL=/api

# --- پروکسی Next برای توسعه (origin بک‌اند، بدون /api) ---
# اگر nginx خودش /api و /uploads را به بک‌اند می‌فرستد، این را خالی بگذارید.
API_PROXY_TARGET=http://127.0.0.1:4000

# --- API داخلی برای fetchهای سمت سرور Next (SSR) ---
# برای آدرس نسبی مرورگر این مقدار را تنظیم کنید؛ فقط runtime خوانده می‌شود.
# روی سرور محصول آدرس داخلی واقعی بک‌اند را با پسوند /api قرار دهید.
API_URL=http://127.0.0.1:4000/api

# --- پایهٔ URL تصاویر آپلودشده (اختیاری) ---
# با API نسبی و مقدار خالی، تصاویر از /uploads روی همان دامنهٔ فرانت
# دریافت می‌شوند. API_PROXY_TARGET یا nginx باید /uploads را به بک‌اند
# پراکسی کند. برای CDN یا API روی هاست جدا، origin عمومی و قابل دسترس از
# مرورگر را وارد کنید؛ هرگز localhost را در مرورگر راه دور استفاده نکنید.
# آدرس مطلق هنگام build به images.remotePatterns اضافه می‌شود.
NEXT_PUBLIC_IMAGE_URL=

# اعتبار نشست و نقش‌ها از API تأیید می‌شود؛ فرانت به سکرت JWT نیازی ندارد.

# --- سکرت وبهوک پاک‌سازی کش (اختیاری ولی توصیه‌شده) ---
# صفحهٔ عمومی آرایشگر و فهرست‌ها با ISR کش می‌شوند (۵ دقیقه). پنل ادمین و پنل
# آرایشگر خودشان بعد از هر تغییر کش را on-demand پاک می‌کنند، اما اگر تایید
# پروفایل از مسیر دیگری (اسکریپت/اپ/بات که مستقیم با API حرف می‌زند) انجام
# شود، بک‌اند با این سکرت وبهوک `POST /api/revalidate` را صدا می‌زند تا کش
# همان لحظه تازه شود. همین مقدار را در env بک‌اند هم بگذارید؛ اگر تنظیم نشود
# وبهوک ۵۰۳ می‌دهد و تغییرات حداکثر ۵ دقیقه بعد دیده می‌شوند.
#   REVALIDATE_SECRET=یک-رشته-تصادفی-طولانی
# REVALIDATE_SECRET=

# --- نرخ نمونه‌برداری traceهای Sentry — اختیاری ---
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# محدودیت آپلود بلاگ؛ با BLOG_IMAGE_MAX_MB و BLOG_VIDEO_MAX_MB بک‌اند هماهنگ باشد.
NEXT_PUBLIC_BLOG_IMAGE_MAX_MB=5
NEXT_PUBLIC_BLOG_VIDEO_MAX_MB=50
