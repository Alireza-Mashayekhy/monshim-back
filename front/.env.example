# ===== Monshim Front (Next.js) — متغیرهای محیطی =====
# این فایل را به `.env.local` کپی کنید و مقادیر را کامل کنید.
# روی سرور محصول هم همین متغیرها باید در env فرانت (PM2/پروسهٔ next start)
# ست شوند؛ مقادیر نمونهٔ سرور در کامنت هر متغیر آمده است.

# --- آدرس API برای مرورگر (axios در services/api/client.ts) ---
# مقدار NEXT_PUBLIC_* هنگام build داخل باندل مرورگر اینلاین می‌شود؛
# تغییرش روی سرور نیازمند build مجدد است.
#   لوکال: http://localhost:4000/api   (پورتی که بک‌اند لوکال روی آن است)
#   سرور:  https://monshiim.ir/api
# ⚠️ پسوند ‎/api‎ الزامی است؛ بک‌اند Nest پیشوند سراسری `api` دارد.
# ⚠️ اگر اینجا آدرس «نسبی» بگذاری (مثل ‎/api‎)، مرورگر مشکلی ندارد ولی
#    fetchهای سمت سرور Next از کار می‌افتند و صفحه‌هایی مثل
#    ‎/panel/barber/[id]‎ روی سرور ۴۰۴ می‌دهند؛ در آن حالت حتماً
#    API_URL زیر را ست کن.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- آدرس API فقط برای fetchهای سمت سرور Next (SSR) — اختیاری ---
# اگر ست نشود از NEXT_PUBLIC_API_URL استفاده می‌شود (به شرط مطلق‌بودن).
# روی سرور بهتر است آدرس «داخلی» بک‌اند باشد تا درخواستِ خودِ سرور به
# دامنهٔ عمومیش برنگردد (روی خیلی از VPSها به‌خاطر hairpin NAT/فایروال
# همان‌جا می‌شکند). این متغیر فقط runtime خوانده می‌شود؛ تغییرش فقط
# restart می‌خواهد، نه build.
#   سرور (فرانت روی هاست + بک‌اند داکری با پورت 3000 منتشرشده):
#     API_URL=http://127.0.0.1:3000/api
# API_URL=

# --- پایهٔ URL تصاویر آپلودشده (پروفایل و نمونه‌کار آرایشگر) ---
# مسیری که از API برمی‌گردد نسبی است (مثل ‎/uploads/profiles/x.png‎) و
# به این پایه چسبانده می‌شود؛ پس این origin باید ‎/uploads‎ را به
# بک‌اند برساند (بک‌اند استاتیک را روی ‎/uploads‎ سرو می‌کند، بدون ‎/api‎).
#   لوکال: http://localhost:4000
#   سرور:  https://api.monshiim.ir  (به شرط پروکسی‌شدن ‎/uploads‎ در nginx)
#
# ⚠️ این متغیر اختیاری است: اگر خالی بماند، همان origin از
#    ‎NEXT_PUBLIC_API_URL‎ استخراج می‌شود (‎https://monshiim.ir/api‎ →
#    ‎https://monshiim.ir‎). خالی‌گذاشتنِ چیزی جز این دو (مثلاً ست‌نکردن
#    هر دو) باعث می‌شود آدرس تصویر نسبی بماند و از دامنهٔ فرانت خواسته
#    شود → تصویر پروفایل/آواتار در هدر نمایش داده نمی‌شود.
#    هاست این مقدار خودکار به `images.remotePatterns` در next.config.ts
#    اضافه می‌شود تا بهینه‌ساز تصویر Next درخواست را رد نکند.
NEXT_PUBLIC_IMAGE_URL=http://localhost:4000

# --- سکرت JWT برای اعتبارسنجی توکن در proxy.ts ---
# باید دقیقاً با JWT_ACCESS_SECRET بک‌اند یکی باشد.
JWT_ACCESS_SECRET=change-me

# --- نرخ نمونه‌برداری traceهای Sentry — اختیاری ---
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
