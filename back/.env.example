# ============================================================================
# متغیرهای محیطی بک‌اند Monshim
# ============================================================================
# این فایل الگو است؛ مقادیر واقعی را در `.env` روی سرور بگذارید.
# `.env` هرگز نباید در گیت باشد (در `.gitignore` هست).
#
# ⚠️ متغیرهای علامت‌دار با ❗️ **الزامی** هستند؛ نبودشان سرویس را از کار می‌اندازد.
# بقیه اختیاری‌اند و مقدار پیش‌فرض دارند.
# ============================================================================

# --- اجرا -------------------------------------------------------------------
# در production حتماً `production` باشد: `synchronize` TypeORM و Swagger
# فقط وقتی این مقدار `production` نباشد فعال می‌شوند.
NODE_ENV=production

# پورتی که سرویس روی آن گوش می‌دهد. پیش‌فرض کد: 3000.
# ⚠️ اگر این را عوض کنید، باید nginx و docker-compose هم عوض شوند.
PORT=3000

# فقط برای تشخیص نسخه در `/api/health`. اختیاری.
APP_VERSION=

# --- پایگاه داده (MySQL) ----------------------------------------------------
# ❗️ الزامی
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=monshim

# --- Redis ------------------------------------------------------------------
# برای ابطال نشست‌ها (logout) و محدودیت نرخ استفاده می‌شود.
# ❗️ الزامی — بدون Redis، ورود/خروج و برخی مسیرها کار نمی‌کنند.
REDIS_HOST=redis
REDIS_PORT=6379

# --- احراز هویت -------------------------------------------------------------
# ❗️ الزامی. هر دو باید رشته‌های تصادفی طولانی و **متفاوت** باشند.
# حداقل ۳۲ کاراکتر. برای تولید:
#   openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# کد OTP جهانی برای تست/پشتیبانی. ❗️ در production خالی بگذارید،
# وگرنه هر کسی می‌تواند با آن وارد شود.
OTP_UNIVERSAL_CODE=

# --- آدرس‌ها ----------------------------------------------------------------
# origin کامل فرانت، بدون مسیر و بدون اسلش انتهایی.
#   درست : https://monshiim.ir
#   غلط  : https://monshiim.ir/panel   یا   https://monshiim.ir/
# اگر اشتباه باشد، کاربر بعد از پرداخت به آدرس اشتباه ریدایرکت می‌شود
# (سرویس یک هشدار در لاگ می‌دهد و از origin درخواست استفاده می‌کند).
FRONTEND_URL=https://monshiim.ir

# نام قدیمی همین متغیر؛ کد هر دو را می‌خواند. یکی کافی است.
# FRONT_URL=

# اگر سرویس پشت nginx/Cloudflare است، این را `true` بگذارید.
# بدون آن، محدودیت نرخ همهٔ کاربران را یک IP می‌بیند و سایت ۴۲۹ می‌شود.
TRUST_PROXY=true

# دامنه‌های مجاز CORS، با کاما جدا شوند. خالی = همه مجاز (فقط برای توسعه).
CORS_ORIGIN=https://monshiim.ir,https://www.monshiim.ir

# --- محدودیت نرخ ------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- پیامک (SMS.ir) ---------------------------------------------------------
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=

# --- درگاه پرداخت (زیبال) ---------------------------------------------------
ZIBAL_MERCHANT=
# `true` یعنی درگاه شبیه‌سازی شود و پول واقعی جابه‌جا نشود.
# ❗️ در production باید خالی یا `false` باشد.
ZIBAL_MOCK=

# --- درگاه جایگزین (زوحال) --------------------------------------------------
ZOHAL_API_TOKEN=
ZOHAL_BASE_URL=
ZOHAL_MOCK=

# --- اعلان‌های بله -----------------------------------------------------------
BALE_ENABLED=
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# --- زمان‌بندی‌ها (ساعت/دقیقه) ----------------------------------------------
SLOT_HOLD_MINUTES=
DEPOSIT_PAYMENT_TIMEOUT_HOURS=
AUTO_COMPLETE_BOOKINGS=
AUTO_COMPLETE_GRACE_HOURS=
AUTO_EXPIRE_UNAPPROVED=
EXPIRE_UNPAID_DEPOSITS=
PAYMENT_RECONCILE=

# --- بازاعتبارسنجی فرانت ----------------------------------------------------
REVALIDATE_SECRET=
