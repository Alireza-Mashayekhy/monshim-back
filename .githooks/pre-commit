#!/bin/sh
# ---------------------------------------------------------------------------
# گارد قبل از commit — سریع، آفلاین، بدون تغییر فایل.
#
# فلسفه: فقط چیزهایی که در چند ثانیه بررسی می‌شوند و «قطعاً» خطا هستند.
# تست کامل این‌جا اجرا نمی‌شود: کند می‌شود و آدم‌ها را به `--no-verify` عادت
# می‌دهد. تست کامل کار CI است.
#
# نصب (یک‌بار برای هر clone):
#   git config core.hooksPath .githooks
# ---------------------------------------------------------------------------
set -u

fail() {
  echo "" >&2
  echo "✖ commit متوقف شد: $1" >&2
  echo "  (رد کردن: git commit --no-verify — ولی اول خطا را بفهمید)" >&2
  echo "" >&2
  exit 1
}

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# ---------------------------------------------------------------------------
# ۱. فایل .env هرگز commit نشود
#    (.gitignore پوشش می‌دهد، ولی تایپوی .gitignore هم اتفاق می‌افتد)
# ---------------------------------------------------------------------------
env_hits=$(echo "$staged" | grep -E '(^|/)\.env($|\.(local|production|prod)$)' || true)
if [ -n "$env_hits" ]; then
  echo "$env_hits" >&2
  fail "فایل .env نباید در گیت باشد. مقادیر را در .env.example (بدون مقدار واقعی) مستند کنید."
fi

# ---------------------------------------------------------------------------
# ۲. کلید/توکن واقعی در محتوای فایل‌های staged
# ---------------------------------------------------------------------------
code_files=$(echo "$staged" | grep -E '\.(ts|tsx|js|mjs|cjs|json|ya?ml|md|sql|sh)$' || true)
if [ -n "$code_files" ]; then
  # فقط خطوط «افزوده‌شده» را نگاه کن، نه زمینه.
  # نکته: `{|}` در ERE یعنی تکرار — نه گروه. پس از کاراکترهای ساده استفاده می‌کنیم.
  added=$(git diff --cached -U0 -- $code_files | grep -E '^\+' | grep -vE '^\+\+\+' || true)

  # نامزدهای مشکوک
  suspects=$(echo "$added" | grep -iE '.*(BOT_TOKEN|API_KEY|SECRET_KEY|PRIVATE_KEY|ACCESS_TOKEN).*["'"'"'][^"'"'"']{20,}["'"'"']' || true)

  # استثناها — مقادیر آشکارا ساختگی/نمونه‌ای، نه کلید واقعی.
  # بدون این استثناها hook روی fixtureهای تست false positive می‌دهد و
  # آدم‌ها را به `--no-verify` عادت می‌دهد (که کل محافظ را بی‌اثر می‌کند).
  if [ -n "$suspects" ]; then
    real=$(echo "$suspects" | grep -viE 'SUPER_SECRET|FAKE|DUMMY|EXAMPLE|PLACEHOLDER|CHANGEME|YOUR_|XXX|TEST_|SAMPLE|<[A-Z_]+>|\$\{' || true)
  else
    real=""
  fi

  if [ -n "$real" ]; then
    echo "$real" | head -3 >&2
    fail "به نظر می‌رسد یک کلید/توکن واقعی در تغییرات است. مقدارش را با placeholder عوض کنید."
  fi
fi

# ---------------------------------------------------------------------------
# ۳. بررسی نوع‌ها — فقط اگر node_modules موجود باشد (وگرنه CI انجام می‌دهد)
# ---------------------------------------------------------------------------
if echo "$staged" | grep -qE '^back/.*\.ts$'; then
  if [ -x back/node_modules/.bin/tsc ]; then
    printf '… tsc (back)\n'
    ( cd back && ./node_modules/.bin/tsc --noEmit ) || fail "خطای TypeScript در بک‌اند."
  else
    printf '… node_modules بک‌اند نیست؛ tsc رد شد (CI انجام می‌دهد)\n'
  fi
fi

if echo "$staged" | grep -qE '^front/.*\.(ts|tsx)$'; then
  if [ -x front/node_modules/.bin/tsc ]; then
    printf '… tsc (front)\n'
    ( cd front && ./node_modules/.bin/tsc --noEmit ) || fail "خطای TypeScript در فرانت."
  else
    printf '… node_modules فرانت نیست؛ tsc رد شد (CI انجام می‌دهد)\n'
  fi
fi

exit 0
