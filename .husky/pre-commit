#!/bin/sh
# ---------------------------------------------------------------------------
# pre-commit — سریع، آفلاین، بدون تغییر تصادفی فایل.
#
# نصب خودکار:
#   pnpm install        (اسکریپت "prepare" این کار را می‌کند)
# یا دستی:
#   git config core.hooksPath .husky
#
# فلسفه: تست کامل این‌جا اجرا نمی‌شود؛ کند می‌شود و آدم‌ها را به
# `--no-verify` عادت می‌دهد. تست کامل کار CI است.
# ---------------------------------------------------------------------------
set -u

fail() {
  echo "" >&2
  echo "✖ commit متوقف شد: $1" >&2
  echo "  (رد کردن: git commit --no-verify — ولی اول خطا را بفهمید)" >&2
  echo "" >&2
  exit 1
}

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# ---------------------------------------------------------------------------
# ۱. فایل .env هرگز commit نشود
# ---------------------------------------------------------------------------
env_hits=$(echo "$staged" | grep -E '(^|/)\.env($|\.(local|production|prod)$)' || true)
if [ -n "$env_hits" ]; then
  echo "$env_hits" >&2
  fail "فایل .env نباید در گیت باشد. مقادیر را در .env.example (بدون مقدار واقعی) مستند کنید."
fi

# ---------------------------------------------------------------------------
# ۲. کلید/توکن واقعی در محتوای فایل‌های staged
# ---------------------------------------------------------------------------
code_files=$(echo "$staged" | grep -E '\.(ts|tsx|js|mjs|cjs|json|ya?ml|md|sql|sh)$' || true)
if [ -n "$code_files" ]; then
  added=$(git diff --cached -U0 -- $code_files | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  suspects=$(echo "$added" | grep -iE '.*(BOT_TOKEN|API_KEY|SECRET_KEY|PRIVATE_KEY|ACCESS_TOKEN).*["'"'"'][^"'"'"']{20,}["'"'"']' || true)

  # استثنا: مقادیر آشکارا ساختگی (fixtureهای تست). بدون این، hook روی
  # نمونه‌های واقعیِ داخل تست false positive می‌دهد و بی‌اعتبار می‌شود.
  if [ -n "$suspects" ]; then
    real=$(echo "$suspects" | grep -viE 'SUPER_SECRET|FAKE|DUMMY|EXAMPLE|PLACEHOLDER|CHANGEME|YOUR_|XXX|TEST_|SAMPLE|<[A-Z_]+>|\$\{' || true)
  else
    real=""
  fi

  if [ -n "$real" ]; then
    echo "$real" | head -3 >&2
    fail "به نظر می‌رسد یک کلید/توکن واقعی در تغییرات است. مقدارش را با placeholder عوض کنید."
  fi
fi

# ---------------------------------------------------------------------------
# ۳. lint روی فایل‌های staged (سریع — فقط چیزی که تغییر کرده)
#    اگر lint-staged نصب نباشد، بی‌صدا رد می‌شود (CI جایگزینش است)
# ---------------------------------------------------------------------------
if [ -x node_modules/.bin/lint-staged ]; then
  printf '… lint-staged\n'
  ./node_modules/.bin/lint-staged >/dev/null 2>&1 || fail "lint روی فایل‌های staged خطا داد. با 'pnpm lint:staged' جزئیات را ببینید."
fi

# ---------------------------------------------------------------------------
# ۴. بررسی نوع‌ها — فقط اگر node_modules موجود باشد (وگرنه CI انجام می‌دهد)
# ---------------------------------------------------------------------------
if echo "$staged" | grep -qE '^apps/api/.*\.ts$'; then
  if [ -x apps/api/node_modules/.bin/tsc ]; then
    printf '… tsc (apps/api)\n'
    ( cd apps/api && ./node_modules/.bin/tsc --noEmit ) || fail "خطای TypeScript در apps/api."
  else
    printf '… node_modules نیست؛ tsc رد شد (CI انجام می‌دهد)\n'
  fi
fi

if echo "$staged" | grep -qE '^apps/web/.*\.(ts|tsx)$'; then
  if [ -x apps/web/node_modules/.bin/tsc ]; then
    printf '… tsc (apps/web)\n'
    ( cd apps/web && ./node_modules/.bin/tsc --noEmit ) || fail "خطای TypeScript در apps/web."
  else
    printf '… node_modules نیست؛ tsc رد شد (CI انجام می‌دهد)\n'
  fi
fi

exit 0
